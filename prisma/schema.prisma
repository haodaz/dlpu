generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 全景数据 Hub
model PanoramicData {
  id              String   @id @default(uuid())
  templateCode    String   // 对应19个模板，如 "T03", "T11"
  sourceType      String   // 数据来源(全域唯一取值,见 src/lib/source-type.ts): "MANUAL" 教师上传 / "SYSTEM" 学校系统导入 / "AI_SEARCH" AI 搜索 / "MULTI_AGENT_AI" 多智能体生成
  rawPayload      String   // 原始收集数据 (JSON字符串)
  verifiedFields  String?  // 经过AI提炼和人工确认的全景字段 (JSON字符串)
  status          String   @default("PENDING") // PENDING (待处理), PROCESSED (已提炼), CONFIRMED (已确认)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
