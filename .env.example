# ============================================================
# 环境变量模板 — 复制为 .env 后按需填写
# 本地最小启动：全部可留空（均有代码默认值）
# 启用 AI 功能最少需要：DASHSCOPE_API_KEY
# ============================================================

# ---------- 数据库 / 存储 ----------
# Prisma SQLite 连接串；默认 file:<项目根>/data/app.db（Vercel 下 /tmp/dlpu-data）
DATABASE_URL="file:./data/app.db"
# 行业飞轮文件存储目录；默认 data/industry-flywheel
# INDUSTRY_DATA_DIR=""

# ---------- LLM（多提供商自动检测：dashscope → deepseek → openai） ----------
# 阿里云百炼 API Key（优先级最高；行业报告 /api/industry-report 必需）
DASHSCOPE_API_KEY=""
# DashScope 兼容端点
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# DashScope 模型名；默认 qwen3.7-plus（行业报告）/ qwen-plus（其他）
# DASHSCOPE_MODEL=""

# DeepSeek API Key（第二优先级）
# DEEPSEEK_API_KEY=""
# DeepSeek 模型名；默认 deepseek-v3.2-exp（评价引擎为 deepseek-chat）
# DEEPSEEK_MODEL=""

# OpenAI API Key（第三优先级）
# OPENAI_API_KEY=""

# 评价引擎模型全局覆盖（优先于 provider 默认模型）
# LLM_MODEL=""

# Gemini API Key（人才/资源深搜的兜底模型）
# GEMINI_API_KEY=""

# ---------- 搜索 ----------
# 搜索用模型；默认 qwen-plus
# SEARCH_MODEL="qwen-plus"
# SerpAPI Key（人才深搜网页抓取）
# SERPAPI_KEY=""
# 博查搜索 API Key
# BOCHA_API_KEY=""

# ---------- 外部平台 / MCP 服务 ----------
# VisioSquare 服务端 token（人才 / 政策 / 行业数据）
# VISIONSQUARE_AUTH_BEARER=""
# VisioSquare MCP endpoint
# VISIONSQUARE_DATA_HOST=""
# Flora 服务端 token（知识库 / 圆桌 / 云配置）
# FLORA_AUTH_BEARER=""
# Flora 服务地址（知识库文件接口使用）
# FLORA_HOST=""
# Redis 连接（缓存）；端口默认 6379
# FLORA_REDIS_HOST=""
# FLORA_REDIS_PORT="6379"
# 知机 Pro 前端可见地址（构建期注入的 NEXT_PUBLIC 变量）
# NEXT_PUBLIC_ZHIJI_HOST="https://ask.mesquareai.com"
# ORCID OAuth（学者检索）
# ORCID_CLIENT_ID=""
# ORCID_CLIENT_SECRET=""

# ---------- 鉴权 / API ----------
# 设为 true 开启接口登录鉴权（登录态来自 zhiji_token cookie / Bearer）
# 不设置 = 本地演示模式，接口完全放开；生产环境建议开启
# API_REQUIRE_AUTH="true"
# 旧变量，设为 true 同样开启鉴权
# INDUSTRY_LOG_REQUIRE_ADMIN="true"
# /api/data-import 数据导入接口的访问令牌
# DATA_IMPORT_TOKEN=""

# 专业建设知识库(平方高教知识库,与一答「专家智库」同源):一答主站 MCP 地址与访问令牌;不配置时显示示例条目
HIGHER_ED_KB_ENDPOINT=
HIGHER_ED_KB_TOKEN=
